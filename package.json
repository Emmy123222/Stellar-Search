{
  "name": "stellar-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepush:check": "npm run build && npm test && npm run lint && npm run typecheck",
    "config:check": "tsx scripts/check-config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:smoke": "tsx scripts/verify-deployment.ts",
    "smoke": "tsx scripts/verify-deployment.ts",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "docker:build": "docker build -t stellar-search .",
    "docker:run": "docker run -p 3001:3001 --env-file .env stellar-search",
    "mcp": "tsx mcp-server/index.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "search:cli": "tsx scripts/test-search.ts",
    "test:search": "npm run search:cli -- \"Stellar blockchain\" --mode search",
    "test:quote": "npm run search:cli -- \"Stellar blockchain\" --mode quote --json",
    "test:suggestions": "npm run search:cli -- \"Stellar blockchain\" --mode search --count 3",
    "openapi:validate": "redocly lint openapi.yaml --config redocly.yaml",
    "reconcile:report": "tsx scripts/reconcile-report.ts",
    "deploy": "npm run build && vercel --prod",
    "build:types": "tsc && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.0.0",
    "@vercel/node": "^10.0.0",
    "@x402/core": "^2.24.0",
    "@x402/express": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "@x402/stellar": "^2.24.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "groq-sdk": "^0.9.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tsx": "^4.7.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/recharts": "^2.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.35",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.55.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'"
    ]
  }
}
