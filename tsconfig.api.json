{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "outDir": "./dist/api",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["api/**/*", "src/lib/constants.ts", "src/lib/paymentIntegrity.ts", "src/lib/urlSanitizer.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
