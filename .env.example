# ════════════════════════════════════════════════════
#  StellarSearch — Environment Variables
#  Copy to .env and fill in your real values
# ════════════════════════════════════════════════════

# ─── Stellar: server receiving wallet ────────────────
# This address receives 0.001 USDC for every search
# Generate at: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_RECEIVING_ADDRESS=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Stellar network ─────────────────────────────────
# stellar:testnet  → development (free testnet USDC)
# stellar:mainnet  → production  (real USDC)
STELLAR_NETWORK=stellar:testnet
VITE_STELLAR_NETWORK=stellar:testnet

# ─── x402 Facilitator ────────────────────────────────────
# Uses the official Coinbase x402 facilitator (no API key needed for testnet)
# Docs: https://developers.stellar.org/docs/build/agentic-payments/x402/built-on-stellar
FACILITATOR_URL=https://www.x402.org/facilitator

# ─── Serper.dev Search API ──────────────────────────────
# Google search results via Serper.dev (free tier: 2,500 queries/month)  
# Sign up at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# ─── Groq AI ─────────────────────────────────────────
# Powers the floating AI assistant (Llama 3.3 70B)
# Free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Server ──────────────────────────────────────────
PORT=3001
RATE_LIMIT_PER_MINUTE=30

# Payment values must remain equivalent: 0.001 × 10,000,000 = 10000 stroops.
PAYMENT_AMOUNT_USDC=0.001
PAYMENT_AMOUNT_STROOPS=10000

# Comma-separated browser origins allowed when NODE_ENV=production.
# Development always uses * regardless of this value.
# Example: http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (Vite env vars) ────────────────────────
# Same-origin API base. Vite proxies /api to the local Express server in development.
VITE_SERVER_URL=/api

# ─── MCP server ──────────────────────────────────────
SEARCH_API_URL=http://localhost:3001
